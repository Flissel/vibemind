{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:minibook-projection-request:v1",
  "title": "MinibookProjectionRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "project_refs", "task_refs", "trace_id", "space_id", "requested_views", "filters", "as_of_cursor", "as_of_ref", "read_only", "bounds", "request_hash", "quote_ref", "approval_refs", "idempotency_key", "requested_at"],
  "properties": {
    "contract_version": {"const": "v1"},
    "request_id": {"$ref": "#/$defs/requestRef"},
    "project_refs": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/projectRef"}},
    "task_refs": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/taskRef"}},
    "trace_id": {"$ref": "#/$defs/traceRef"},
    "space_id": {"const": "minibook"},
    "requested_views": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"enum": ["projects", "tasks", "briefs", "todos", "sessions", "approvals", "costs", "logs", "prs", "results", "handoffs", "evidence"]}},
    "filters": {"$ref": "#/$defs/filters"},
    "as_of_cursor": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "as_of_ref": {"$ref": "#/$defs/ledgerRef"},
    "read_only": {"const": true},
    "bounds": {"$ref": "#/$defs/bounds"},
    "request_hash": {"$ref": "#/$defs/hash"},
    "quote_ref": {"$ref": "#/$defs/quoteRef"},
    "approval_refs": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/approvalRef"}},
    "idempotency_key": {"$ref": "#/$defs/idempotency"},
    "requested_at": {"$ref": "#/$defs/time"}
  },
  "$defs": {
    "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "projectRef": {"type": "string", "pattern": "^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "ledgerRef": {"type": "string", "pattern": "^ledger_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "quoteRef": {"type": "string", "pattern": "^quote_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "approvalRef": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "idempotency": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "filters": {"type": "object", "additionalProperties": false, "required": ["project_refs", "task_refs", "include_incomplete"], "properties": {"project_refs": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/projectRef"}}, "task_refs": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/taskRef"}}, "include_incomplete": {"type": "boolean"}}},
    "bounds": {"type": "object", "additionalProperties": false, "required": ["max_projects", "max_tasks_per_project", "max_events"], "properties": {"max_projects": {"type": "integer", "minimum": 1, "maximum": 1000}, "max_tasks_per_project": {"type": "integer", "minimum": 1, "maximum": 10000}, "max_events": {"type": "integer", "minimum": 1, "maximum": 100000}}}
  }
}
