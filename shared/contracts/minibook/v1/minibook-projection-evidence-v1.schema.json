{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:minibook-projection-evidence:v1",
  "title": "MinibookProjectionEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "evidence_id", "request_id", "projection_id", "snapshot_ref", "delta_ref", "snapshot_cursor", "delta_to_cursor", "source_evidence_refs", "source_log_refs", "row_counts", "cost_provenance_refs", "generated_at", "completed_at", "stale", "complete"],
  "properties": {"contract_version": {"const": "v1"}, "evidence_id": {"$ref": "#/$defs/evidenceRef"}, "request_id": {"$ref": "#/$defs/requestRef"}, "projection_id": {"$ref": "#/$defs/projectionRef"}, "snapshot_ref": {"$ref": "#/$defs/projectionRef"}, "delta_ref": {"$ref": "#/$defs/deltaRef"}, "snapshot_cursor": {"$ref": "#/$defs/cursor"}, "delta_to_cursor": {"$ref": "#/$defs/cursor"}, "source_evidence_refs": {"$ref": "#/$defs/refs"}, "source_log_refs": {"$ref": "#/$defs/refs"}, "row_counts": {"$ref": "#/$defs/counts"}, "cost_provenance_refs": {"$ref": "#/$defs/refs"}, "generated_at": {"$ref": "#/$defs/time"}, "completed_at": {"$ref": "#/$defs/time"}, "stale": {"type": "boolean"}, "complete": {"type": "boolean"}},
  "$defs": {"evidenceRef": {"type": "string", "pattern": "^evidence_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "projectionRef": {"type": "string", "pattern": "^projection_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "deltaRef": {"type": "string", "pattern": "^delta_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "cursor": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "time": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}, "ref": {"type": "string", "pattern": "^[a-z][a-z_]*_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "refs": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}, "counts": {"type": "object", "additionalProperties": false, "required": ["project_count", "task_count", "event_count"], "properties": {"project_count": {"type": "integer", "minimum": 0, "maximum": 1000}, "task_count": {"type": "integer", "minimum": 0, "maximum": 10000000}, "event_count": {"type": "integer", "minimum": 0, "maximum": 100000000}}}}
}
