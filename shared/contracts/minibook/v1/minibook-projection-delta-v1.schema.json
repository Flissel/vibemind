{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:minibook-projection-delta:v1",
  "title": "MinibookProjectionDeltaV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "delta_id", "projection_id", "request_id", "trace_id", "space_id", "from_cursor", "to_cursor", "source_ledger_refs", "events", "generated_at"],
  "properties": {"contract_version": {"const": "v1"}, "delta_id": {"$ref": "#/$defs/deltaRef"}, "projection_id": {"$ref": "#/$defs/projectionRef"}, "request_id": {"$ref": "#/$defs/requestRef"}, "trace_id": {"$ref": "#/$defs/traceRef"}, "space_id": {"const": "minibook"}, "from_cursor": {"$ref": "#/$defs/cursor"}, "to_cursor": {"$ref": "#/$defs/cursor"}, "source_ledger_refs": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/ledgerRef"}}, "events": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/event"}}, "generated_at": {"$ref": "#/$defs/time"}},
  "$defs": {"deltaRef": {"type": "string", "pattern": "^delta_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "projectionRef": {"type": "string", "pattern": "^projection_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "ledgerRef": {"type": "string", "pattern": "^ledger_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "projectRef": {"type": "string", "pattern": "^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "eventRef": {"type": "string", "pattern": "^event_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "cursor": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "time": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}, "event": {"type": "object", "additionalProperties": false, "required": ["event_ref", "source_revision", "event_order", "project_ref", "task_ref", "row_hash"], "properties": {"event_ref": {"$ref": "#/$defs/eventRef"}, "source_revision": {"type": "integer", "minimum": 1, "maximum": 1000000000}, "event_order": {"type": "integer", "minimum": 1, "maximum": 100000}, "project_ref": {"$ref": "#/$defs/projectRef"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "row_hash": {"$ref": "#/$defs/hash"}}}}
}
