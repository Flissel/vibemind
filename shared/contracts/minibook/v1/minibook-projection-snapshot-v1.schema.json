{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:minibook-projection-snapshot:v1",
  "title": "MinibookProjectionSnapshotV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "projection_id", "projection_version", "projection_hash", "request_id", "trace_id", "space_id", "snapshot_cursor", "source_ledger_refs", "generated_at", "project_rows", "stale", "complete"],
  "properties": {
    "contract_version": {"const": "v1"}, "projection_id": {"$ref": "#/$defs/projectionRef"}, "projection_version": {"type": "integer", "minimum": 1, "maximum": 1000000}, "projection_hash": {"$ref": "#/$defs/hash"}, "request_id": {"$ref": "#/$defs/requestRef"}, "trace_id": {"$ref": "#/$defs/traceRef"}, "space_id": {"const": "minibook"}, "snapshot_cursor": {"$ref": "#/$defs/cursor"}, "source_ledger_refs": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/ledgerRef"}}, "generated_at": {"$ref": "#/$defs/time"}, "project_rows": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/projectRow"}}, "stale": {"type": "boolean"}, "complete": {"type": "boolean"}
  },
  "$defs": {
    "projectionRef": {"type": "string", "pattern": "^projection_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "projectRef": {"type": "string", "pattern": "^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "ledgerRef": {"type": "string", "pattern": "^ledger_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "authorityRef": {"type": "string", "pattern": "^authority_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "cursor": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "time": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "ref": {"type": "string", "pattern": "^[a-z][a-z_]*_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "approvalRef": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "refs": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "status": {"enum": ["draft", "clarification_required", "queued", "waiting_for_approval", "scheduled", "running", "paused", "succeeded", "failed", "cancelled", "unavailable"]},
    "projectRow": {"type": "object", "additionalProperties": false, "required": ["project_ref", "task_rows"], "properties": {"project_ref": {"$ref": "#/$defs/projectRef"}, "task_rows": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/taskRow"}}}},
    "taskRow": {"type": "object", "additionalProperties": false, "required": ["task_ref", "task_order", "parent_task_ref", "depends_on_task_refs", "brief_refs", "todo_refs", "session_refs", "lifecycle_status", "authority_ref", "approval_refs", "cost_provenance_refs", "log_refs", "pr_refs", "result_refs", "handoff_refs", "source_evidence_refs", "created_at", "updated_at", "complete"], "properties": {"task_ref": {"$ref": "#/$defs/taskRef"}, "task_order": {"type": "integer", "minimum": 1, "maximum": 10000}, "parent_task_ref": {"type": ["string", "null"], "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "depends_on_task_refs": {"type": "array", "maxItems": 9999, "uniqueItems": true, "items": {"$ref": "#/$defs/taskRef"}}, "brief_refs": {"$ref": "#/$defs/refs"}, "todo_refs": {"$ref": "#/$defs/refs"}, "session_refs": {"$ref": "#/$defs/refs"}, "lifecycle_status": {"$ref": "#/$defs/status"}, "authority_ref": {"$ref": "#/$defs/authorityRef"}, "approval_refs": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/approvalRef"}}, "cost_provenance_refs": {"$ref": "#/$defs/refs"}, "log_refs": {"$ref": "#/$defs/refs"}, "pr_refs": {"$ref": "#/$defs/refs"}, "result_refs": {"$ref": "#/$defs/refs"}, "handoff_refs": {"$ref": "#/$defs/refs"}, "source_evidence_refs": {"$ref": "#/$defs/refs"}, "created_at": {"$ref": "#/$defs/time"}, "updated_at": {"$ref": "#/$defs/time"}, "complete": {"type": "boolean"}}}
  }
}
