{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:schedule-run-evidence:v1",
  "title": "ScheduleRunEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run_id", "schedule_id", "request_id", "trace_id", "revision", "scheduled_for", "started_at", "completed_at", "outcome", "attempt", "evidence_refs", "artifact_refs", "cost"],
  "properties": {
    "contract_version": {"const": "v1"}, "run_id": {"type": "string", "pattern": "^run_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "schedule_id": {"type": "string", "pattern": "^schedule_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "request_id": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "trace_id": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "revision": {"type": "integer", "minimum": 1, "maximum": 1000000}, "scheduled_for": {"$ref": "#/$defs/timestamp"}, "started_at": {"$ref": "#/$defs/timestamp"}, "completed_at": {"$ref": "#/$defs/timestamp"}, "outcome": {"enum": ["succeeded", "failed", "unavailable"]}, "attempt": {"type": "integer", "minimum": 1, "maximum": 11}, "evidence_refs": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}, "artifact_refs": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^artifact_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}, "error_class": {"enum": ["policy_blocked", "provider_unavailable", "execution_failed", "deadline_exceeded"]}, "cost": {"$ref": "#/$defs/cost"}
  },
  "allOf": [{"if": {"properties": {"outcome": {"const": "succeeded"}}}, "then": {"properties": {"evidence_refs": {"minItems": 1}, "artifact_refs": {"minItems": 1}}, "not": {"required": ["error_class"]}}}, {"if": {"properties": {"outcome": {"enum": ["failed", "unavailable"]}}}, "then": {"required": ["error_class"]}}],
  "$defs": {"timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}, "cost": {"type": "object", "additionalProperties": false, "required": ["actual_cost_minor", "currency", "quote_ref", "approval_ref"], "properties": {"actual_cost_minor": {"type": "integer", "minimum": 0, "maximum": 10000000}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "quote_ref": {"type": "string", "pattern": "^quote_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "approval_ref": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}}}
}
