{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:schedule-definition:v1",
  "title": "ScheduleDefinitionV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "schedule_id", "request_id", "task_brief_ref", "intent_ref", "trace_id", "revision", "timezone", "clarification_required", "idempotency_key", "schedule", "limits", "retry_policy", "budget"],
  "properties": {
    "contract_version": {"const": "v1"}, "schedule_id": {"$ref": "#/$defs/scheduleRef"}, "request_id": {"$ref": "#/$defs/requestRef"}, "task_brief_ref": {"$ref": "#/$defs/taskRef"}, "intent_ref": {"$ref": "#/$defs/intentRef"}, "trace_id": {"$ref": "#/$defs/traceRef"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 1000000}, "timezone": {"$ref": "#/$defs/timezone"}, "clarification_required": {"type": "boolean"}, "idempotency_key": {"$ref": "#/$defs/idempotencyKey"}, "schedule": {"$ref": "#/$defs/schedule"}, "limits": {"$ref": "#/$defs/limits"}, "retry_policy": {"$ref": "#/$defs/retryPolicy"}, "budget": {"$ref": "#/$defs/budget"}
  },
  "$defs": {
    "scheduleRef": {"type": "string", "pattern": "^schedule_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "intentRef": {"type": "string", "pattern": "^intent_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "quoteRef": {"type": "string", "pattern": "^quote_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "approvalRef": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}, "timezone": {"type": "string", "pattern": "^(?:UTC|[A-Za-z][A-Za-z0-9_.+-]*(?:/[A-Za-z][A-Za-z0-9_.+-]*)+)$"}, "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "schedule": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["mode", "run_at"], "properties": {"mode": {"const": "one_shot"}, "run_at": {"$ref": "#/$defs/timestamp"}}}, {"type": "object", "additionalProperties": false, "required": ["mode", "starts_at", "every_seconds"], "properties": {"mode": {"const": "interval"}, "starts_at": {"$ref": "#/$defs/timestamp"}, "every_seconds": {"type": "integer", "minimum": 60, "maximum": 2592000}}}, {"type": "object", "additionalProperties": false, "required": ["mode", "expression"], "properties": {"mode": {"const": "cron"}, "expression": {"type": "string", "pattern": "^(?:[^\\s]+\\s+){4}[^\\s]+$", "maxLength": 200}}}]},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_runs"], "properties": {"max_runs": {"type": "integer", "minimum": 1, "maximum": 1000}}}, "retryPolicy": {"type": "object", "additionalProperties": false, "required": ["max_retries", "retry_delay_seconds"], "properties": {"max_retries": {"type": "integer", "minimum": 0, "maximum": 10}, "retry_delay_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}}}, "budget": {"type": "object", "additionalProperties": false, "required": ["max_cost_minor", "currency", "quote_ref", "approval_ref"], "properties": {"max_cost_minor": {"type": "integer", "minimum": 0, "maximum": 10000000}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "quote_ref": {"$ref": "#/$defs/quoteRef"}, "approval_ref": {"$ref": "#/$defs/approvalRef"}}}
  }
}
