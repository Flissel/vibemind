{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:schedule-request:v1",
  "title": "ScheduleRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "task_brief_ref", "intent_ref", "trace_id", "requested_at", "timezone", "request_kind", "clarification", "idempotency_key", "limits"],
  "properties": {
    "contract_version": {"const": "v1"},
    "request_id": {"$ref": "#/$defs/requestRef"},
    "task_brief_ref": {"$ref": "#/$defs/taskRef"},
    "intent_ref": {"$ref": "#/$defs/intentRef"},
    "trace_id": {"$ref": "#/$defs/traceRef"},
    "requested_at": {"$ref": "#/$defs/timestamp"},
    "timezone": {"$ref": "#/$defs/timezone"},
    "request_kind": {"enum": ["appointment", "reminder"]},
    "clarification": {"$ref": "#/$defs/clarification"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "limits": {"$ref": "#/$defs/limits"}
  },
  "$defs": {
    "ulid": {"type": "string", "pattern": "[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "intentRef": {"type": "string", "pattern": "^intent_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "quoteRef": {"type": "string", "pattern": "^quote_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "approvalRef": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "timezone": {"type": "string", "pattern": "^(?:UTC|[A-Za-z][A-Za-z0-9_.+-]*(?:/[A-Za-z][A-Za-z0-9_.+-]*)+)$"},
    "clarification": {"type": "object", "additionalProperties": false, "required": ["required", "questions"], "properties": {"required": {"type": "boolean"}, "questions": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 500}}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_runs", "max_retries", "max_cost_minor", "currency", "quote_ref", "approval_ref"], "properties": {"max_runs": {"type": "integer", "minimum": 1, "maximum": 1000}, "max_retries": {"type": "integer", "minimum": 0, "maximum": 10}, "max_cost_minor": {"type": "integer", "minimum": 0, "maximum": 10000000}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "quote_ref": {"$ref": "#/$defs/quoteRef"}, "approval_ref": {"$ref": "#/$defs/approvalRef"}}}
  }
}
