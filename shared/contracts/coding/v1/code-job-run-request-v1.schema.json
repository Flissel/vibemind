{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:vibemind:shared:contracts:code-job-run-request:v1","title":"CodeJobRunRequestV1","type":"object","additionalProperties":false,"required":["contract_version","run_id","plan_id","plan_version","plan_hash","request_id","project_ref","task_ref","trace_id","space_id","repository_ref","base_ref","mode","input_artifact_refs","approved_limits","quote_ref","approval_ref","idempotency_key"],"properties":{"contract_version":{"const":"v1"},"run_id":{"$ref":"#/$defs/run"},"plan_id":{"$ref":"#/$defs/plan"},"plan_version":{"type":"integer","minimum":1},"plan_hash":{"$ref":"#/$defs/hash"},"request_id":{"$ref":"#/$defs/request"},"project_ref":{"$ref":"#/$defs/project"},"task_ref":{"$ref":"#/$defs/task"},"trace_id":{"$ref":"#/$defs/trace"},"space_id":{"const":"coding"},"repository_ref":{"$ref":"#/$defs/repository"},"base_ref":{"$ref":"#/$defs/base"},"mode":{"enum":["dry_run","manual"]},"input_artifact_refs":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"$ref":"#/$defs/artifact"}},"approved_limits":{"$ref":"#/$defs/bounds"},"resume_from_checkpoint_ref":{"type":["string","null"],"pattern":"^checkpoint_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"quote_ref":{"$ref":"#/$defs/quote"},"approval_ref":{"$ref":"#/$defs/approval"},"idempotency_key":{"$ref":"#/$defs/idempotency"}},"$defs":{"run":{"type":"string","pattern":"^run_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"plan":{"type":"string","pattern":"^plan_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"request":{"type":"string","pattern":"^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"project":{"type":"string","pattern":"^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"task":{"type":"string","pattern":"^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"trace":{"type":"string","pattern":"^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"repository":{"type":"string","pattern":"^repository_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"base":{"type":"string","pattern":"^base_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"artifact":{"type":"string","pattern":"^artifact_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"quote":{"type":"string","pattern":"^quote_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"approval":{"type":"string","pattern":"^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"idempotency":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},"bounds":{"type":"object","additionalProperties":false,"required":["timeout_seconds","max_steps","max_retries","max_concurrency","max_cost_minor","currency","max_changed_files","max_artifacts","max_test_profiles"],"properties":{"timeout_seconds":{"type":"integer","minimum":1,"maximum":3600},"max_steps":{"type":"integer","minimum":1,"maximum":500},"max_retries":{"type":"integer","minimum":0,"maximum":10},"max_concurrency":{"type":"integer","minimum":1,"maximum":16},"max_cost_minor":{"type":"integer","minimum":0,"maximum":10000000},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"max_changed_files":{"type":"integer","minimum":0,"maximum":10000},"max_artifacts":{"type":"integer","minimum":1,"maximum":1000},"max_test_profiles":{"type":"integer","minimum":1,"maximum":100}}}}}
