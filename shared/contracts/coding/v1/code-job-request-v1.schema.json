{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:vibemind:shared:contracts:code-job-request:v1","title":"CodeJobRequestV1","type":"object","additionalProperties":false,"required":["contract_version","request_id","project_ref","task_ref","trace_id","space_id","objective","change_kind","repository_ref","base_ref","requested_outputs","requested_at","clarification","risk_class","hard_bounds","quote_ref","approval_ref","idempotency_key"],"properties":{"contract_version":{"const":"v1"},"request_id":{"$ref":"#/$defs/request"},"project_ref":{"$ref":"#/$defs/project"},"task_ref":{"$ref":"#/$defs/task"},"trace_id":{"$ref":"#/$defs/trace"},"space_id":{"const":"coding"},"objective":{"type":"string","minLength":1,"maxLength":4000},"change_kind":{"enum":["generate","change","fix","refactor"]},"repository_ref":{"$ref":"#/$defs/repository"},"base_ref":{"$ref":"#/$defs/base"},"requested_outputs":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"enum":["change_set","test_evidence","review_record","artifact"]}},"requested_at":{"$ref":"#/$defs/time"},"clarification":{"$ref":"#/$defs/clarification"},"risk_class":{"enum":["low","moderate","high"]},"hard_bounds":{"$ref":"#/$defs/bounds"},"quote_ref":{"$ref":"#/$defs/quote"},"approval_ref":{"$ref":"#/$defs/approval"},"idempotency_key":{"$ref":"#/$defs/idempotency"}},"$defs":{"request":{"type":"string","pattern":"^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"project":{"type":"string","pattern":"^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"task":{"type":"string","pattern":"^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"trace":{"type":"string","pattern":"^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"repository":{"type":"string","pattern":"^repository_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"base":{"type":"string","pattern":"^base_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"quote":{"type":"string","pattern":"^quote_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"approval":{"type":"string","pattern":"^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},"time":{