{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:flowzen-acceptance-evidence:v1",
  "title": "FlowzenAcceptanceEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "acceptance_id", "recommendation_id", "checkin_id", "subject_ref", "task_brief_ref", "intent_ref", "trace_id", "started_at", "completed_at", "outcome", "readback", "cost"],
  "properties": {
    "contract_version": {"const": "v1"},
    "acceptance_id": {"$ref": "#/$defs/acceptanceRef"},
    "recommendation_id": {"$ref": "#/$defs/recommendationRef"},
    "checkin_id": {"$ref": "#/$defs/checkinRef"},
    "subject_ref": {"$ref": "#/$defs/subjectRef"},
    "task_brief_ref": {"$ref": "#/$defs/taskRef"},
    "intent_ref": {"$ref": "#/$defs/intentRef"},
    "trace_id": {"$ref": "#/$defs/traceRef"},
    "started_at": {"$ref": "#/$defs/timestamp"},
    "completed_at": {"$ref": "#/$defs/timestamp"},
    "outcome": {"enum": ["succeeded", "failed", "unavailable"]},
    "readback": {"type": ["object", "null"], "additionalProperties": false, "required": ["status", "observed_at", "evidence_ref"], "properties": {"status": {"const": "accepted"}, "observed_at": {"$ref": "#/$defs/timestamp"}, "evidence_ref": {"$ref": "#/$defs/evidenceRef"}}},
    "error_class": {"enum": ["policy_blocked", "readback_failed", "deadline_exceeded", "unavailable"]},
    "cost": {"$ref": "#/$defs/cost"}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "succeeded"}}}, "then": {"properties": {"readback": {"type": "object"}}, "not": {"required": ["error_class"]}}},
    {"if": {"properties": {"outcome": {"enum": ["failed", "unavailable"]}}}, "then": {"properties": {"readback": {"type": "null"}}, "required": ["error_class"]}}
  ],
  "$defs": {
    "acceptanceRef": {"type": "string", "pattern": "^acceptance_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "recommendationRef": {"type": "string", "pattern": "^recommendation_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "checkinRef": {"type": "string", "pattern": "^checkin_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "subjectRef": {"type": "string", "pattern": "^subject_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "intentRef": {"type": "string", "pattern": "^intent_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "approvalRef": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "quoteRef": {"type": "string", "pattern": "^quote_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "evidenceRef": {"type": "string", "pattern": "^evidence_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "cost": {"type": "object", "additionalProperties": false, "required": ["actual_cost_minor", "currency", "quote_ref", "approval_ref", "evidence_ref"], "properties": {"actual_cost_minor": {"type": "integer", "minimum": 0, "maximum": 10000000}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "quote_ref": {"$ref": "#/$defs/quoteRef"}, "approval_ref": {"$ref": "#/$defs/approvalRef"}, "evidence_ref": {"$ref": "#/$defs/evidenceRef"}}}
  }
}
