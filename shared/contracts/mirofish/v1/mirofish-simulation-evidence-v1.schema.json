{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiroFishSimulationEvidenceV1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "evidence_id", "run_id", "external_run_ref", "plan_id", "plan_version", "plan_hash", "request_id", "project_ref", "task_ref", "trace_id", "space_id", "request_hash", "outcome", "started_at", "completed_at", "cost"],
  "properties": {
    "contract_version": {"const": "v1"}, "evidence_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "external_run_ref": {"$ref": "#/$defs/id"}, "plan_id": {"$ref": "#/$defs/id"}, "plan_version": {"type": "integer", "minimum": 1}, "plan_hash": {"$ref": "#/$defs/hash"}, "request_id": {"$ref": "#/$defs/id"}, "project_ref": {"$ref": "#/$defs/id"}, "task_ref": {"$ref": "#/$defs/id"}, "trace_id": {"$ref": "#/$defs/id"}, "space_id": {"const": "mirofish"}, "request_hash": {"$ref": "#/$defs/hash"}, "outcome": {"enum": ["succeeded", "failed", "cancelled", "timed_out", "unavailable"]}, "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"}, "external_receipt_ref": {"$ref": "#/$defs/id"}, "graph_artifact": {"$ref": "#/$defs/artifact"}, "simulation_artifact": {"$ref": "#/$defs/artifact"}, "forecast_artifact": {"$ref": "#/$defs/artifact"}, "cost": {"$ref": "#/$defs/cost"}, "error_class": {"enum": ["execution_failed", "timed_out", "external_unavailable", "cancel_not_confirmed"]}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z_]*_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_ref", "content_hash", "provenance_ref", "readback_ref", "verification_ref"], "properties": {"artifact_ref": {"$ref": "#/$defs/id"}, "content_hash": {"$ref": "#/$defs/hash"}, "provenance_ref": {"$ref": "#/$defs/id"}, "readback_ref": {"$ref": "#/$defs/id"}, "verification_ref": {"$ref": "#/$defs/id"}}}, "cost": {"type": "object", "additionalProperties": false, "required": ["actual_cost_minor", "currency", "quote_ref", "approval_ref"], "properties": {"actual_cost_minor": {"type": "integer", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "quote_ref": {"$ref": "#/$defs/id"}, "approval_ref": {"$ref": "#/$defs/id"}}}}
}
