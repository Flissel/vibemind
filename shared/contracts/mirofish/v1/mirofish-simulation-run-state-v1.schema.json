{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiroFishSimulationRunStateV1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "run_id", "external_run_ref", "plan_id", "plan_version", "plan_hash", "request_id", "project_ref", "task_ref", "trace_id", "space_id", "request_hash", "revision", "status", "event_history", "resume_from_checkpoint_ref", "progress", "cancellation_requested", "counters", "cost"],
  "properties": {
    "contract_version": {"const": "v1"}, "run_id": {"$ref": "#/$defs/id"}, "external_run_ref": {"$ref": "#/$defs/id"}, "plan_id": {"$ref": "#/$defs/id"}, "plan_version": {"type": "integer", "minimum": 1}, "plan_hash": {"$ref": "#/$defs/hash"}, "request_id": {"$ref": "#/$defs/id"}, "project_ref": {"$ref": "#/$defs/id"}, "task_ref": {"$ref": "#/$defs/id"}, "trace_id": {"$ref": "#/$defs/id"}, "space_id": {"const": "mirofish"}, "request_hash": {"$ref": "#/$defs/hash"}, "revision": {"type": "integer", "minimum": 1}, "status": {"$ref": "#/$defs/status"},
    "event_history": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["status", "revision", "occurred_at", "checkpoint_ref", "cancellation_ref"], "properties": {"status": {"$ref": "#/$defs/status"}, "revision": {"type": "integer", "minimum": 1}, "occurred_at": {"type": "string", "format": "date-time"}, "checkpoint_ref": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "cancellation_ref": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}}}},
    "resume_from_checkpoint_ref": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "progress": {"type": "object", "additionalProperties": false, "required": ["phase", "completed_units", "total_units", "last_observed_at", "readback_ref"], "properties": {"phase": {"enum": ["graph_build", "simulation", "forecast", "completed"]}, "completed_units": {"type": "integer", "minimum": 0, "maximum": 100}, "total_units": {"type": "integer", "minimum": 1, "maximum": 100}, "last_observed_at": {"type": "string", "format": "date-time"}, "readback_ref": {"$ref": "#/$defs/id"}}}, "cancellation_requested": {"type": "boolean"},
    "counters": {"type": "object", "additionalProperties": false, "required": ["executed_steps", "retry_count", "active_workers", "agent_count", "rounds_completed", "artifact_count", "verification_count"], "properties": {"executed_steps": {"type": "integer", "minimum": 0}, "retry_count": {"type": "integer", "minimum": 0}, "active_workers": {"type": "integer", "minimum": 0}, "agent_count": {"type": "integer", "minimum": 0}, "rounds_completed": {"type": "integer", "minimum": 0}, "artifact_count": {"type": "integer", "minimum": 0}, "verification_count": {"type": "integer", "minimum": 0}}}, "cost": {"$ref": "#/$defs/cost"}, "error_class": {"enum": ["execution_failed", "timed_out", "external_unavailable", "cancel_not_confirmed"]}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z_]*_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "status": {"enum": ["queued", "waiting_for_approval", "running", "paused", "cancellation_requested", "cancelled", "failed", "timed_out", "unavailable", "succeeded"]}, "cost": {"type": "object", "additionalProperties": false, "required": ["actual_cost_minor", "currency", "quote_ref", "approval_ref"], "properties": {"actual_cost_minor": {"type": "integer", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "quote_ref": {"$ref": "#/$defs/id"}, "approval_ref": {"$ref": "#/$defs/id"}}}}
}
