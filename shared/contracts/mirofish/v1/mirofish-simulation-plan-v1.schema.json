{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiroFishSimulationPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "plan_id", "plan_version", "plan_hash", "request_id", "project_ref", "task_ref", "trace_id", "space_id", "request_hash", "requested_outputs", "input_artifact_refs", "input_evidence_refs", "created_at", "phases", "success_criteria", "bounds"],
  "properties": {
    "contract_version": {"const": "v1"}, "plan_id": {"$ref": "#/$defs/id"}, "plan_version": {"type": "integer", "minimum": 1}, "plan_hash": {"$ref": "#/$defs/hash"}, "request_id": {"$ref": "#/$defs/id"}, "project_ref": {"$ref": "#/$defs/id"}, "task_ref": {"$ref": "#/$defs/id"}, "trace_id": {"$ref": "#/$defs/id"}, "space_id": {"const": "mirofish"}, "request_hash": {"$ref": "#/$defs/hash"},
    "requested_outputs": {"type": "array", "items": {"enum": ["graph_artifact", "simulation_artifact", "forecast_artifact"]}, "minItems": 3, "maxItems": 3, "uniqueItems": true}, "input_artifact_refs": {"$ref": "#/$defs/nonempty_ids"}, "input_evidence_refs": {"$ref": "#/$defs/nonempty_ids"}, "created_at": {"type": "string", "format": "date-time"},
    "phases": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["phase_id", "order", "depends_on", "produced_artifact_kind"], "properties": {"phase_id": {"enum": ["graph_build", "simulation", "forecast"]}, "order": {"type": "integer", "minimum": 1, "maximum": 3}, "depends_on": {"type": "array", "maxItems": 2, "items": {"enum": ["graph_build", "simulation", "forecast"]}, "uniqueItems": true}, "produced_artifact_kind": {"enum": ["graph_artifact", "simulation_artifact", "forecast_artifact"]}}}},
    "success_criteria": {"type": "array", "items": {"enum": ["graph-artifact", "simulation-artifact", "forecast-artifact", "readback-verified", "external-receipt"]}, "minItems": 5, "maxItems": 5, "uniqueItems": true}, "bounds": {"$ref": "#/$defs/bounds"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z_]*_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "nonempty_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1, "maxItems": 20, "uniqueItems": true}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "bounds": {"type": "object", "additionalProperties": false, "required": ["timeout_seconds", "max_steps", "max_retries", "max_agents", "max_rounds", "max_artifacts", "max_cost_minor", "currency"], "properties": {"timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "max_steps": {"type": "integer", "minimum": 3, "maximum": 100}, "max_retries": {"type": "integer", "minimum": 0, "maximum": 10}, "max_agents": {"type": "integer", "minimum": 1, "maximum": 1000}, "max_rounds": {"type": "integer", "minimum": 1, "maximum": 1000}, "max_artifacts": {"type": "integer", "minimum": 3, "maximum": 100}, "max_cost_minor": {"type": "integer", "minimum": 0, "maximum": 10000000}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}}}
}
