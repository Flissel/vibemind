{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiroFishSimulationResultV1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "result_id", "evidence_id", "run_id", "external_run_ref", "plan_id", "plan_version", "plan_hash", "request_id", "project_ref", "task_ref", "trace_id", "space_id", "request_hash", "outcome", "started_at", "completed_at", "counters", "cost", "satisfied_criteria_ids"],
  "properties": {
    "contract_version": {"const": "v1"}, "result_id": {"$ref": "#/$defs/id"}, "evidence_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "external_run_ref": {"$ref": "#/$defs/id"}, "plan_id": {"$ref": "#/$defs/id"}, "plan_version": {"type": "integer", "minimum": 1}, "plan_hash": {"$ref": "#/$defs/hash"}, "request_id": {"$ref": "#/$defs/id"}, "project_ref": {"$ref": "#/$defs/id"}, "task_ref": {"$ref": "#/$defs/id"}, "trace_id": {"$ref": "#/$defs/id"}, "space_id": {"const": "mirofish"}, "request_hash": {"$ref": "#/$defs/hash"}, "outcome": {"enum": ["succeeded", "failed", "cancelled", "timed_out", "unavailable"]}, "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"}, "external_receipt_ref": {"$ref": "#/$defs/id"}, "graph_artifact_ref": {"$ref": "#/$defs/id"}, "simulation_artifact_ref": {"$ref": "#/$defs/id"}, "forecast_artifact_ref": {"$ref": "#/$defs/id"}, "readback_refs": {"$ref": "#/$defs/ids"}, "verification_refs": {"$ref": "#/$defs/ids"},
    "counters": {"type": "object", "additionalProperties": false, "required": ["executed_steps", "retry_count", "active_workers", "agent_count", "rounds_completed", "artifact_count", "verification_count"], "properties": {"executed_steps": {"type": "integer", "minimum": 0}, "retry_count": {"type": "integer", "minimum": 0}, "active_workers": {"type": "integer", "minimum": 0}, "agent_count": {"type": "integer", "minimum": 0}, "rounds_completed": {"type": "integer", "minimum": 0}, "artifact_count": {"type": "integer", "minimum": 0}, "verification_count": {"type": "integer", "minimum": 0}}}, "cost": {"$ref": "#/$defs/cost"}, "satisfied_criteria_ids": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"enum": ["graph-artifact", "simulation-artifact", "forecast-artifact", "readback-verified", "external-receipt"]}, "uniqueItems": true}, "error_class": {"enum": ["execution_failed", "timed_out", "external_unavailable", "cancel_not_confirmed"]}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z_]*_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1, "maxItems": 3, "uniqueItems": true}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "cost": {"type": "object", "additionalProperties": false, "required": ["actual_cost_minor", "currency", "quote_ref", "approval_ref"], "properties": {"actual_cost_minor": {"type": "integer", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "quote_ref": {"$ref": "#/$defs/id"}, "approval_ref": {"$ref": "#/$defs/id"}}}}
}
