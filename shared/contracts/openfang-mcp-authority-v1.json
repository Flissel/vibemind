  "registration_authority": {
    "registration_mechanism": "An MCP server is registered if and only if it appears as a [[mcp_servers]] entry (McpServerConfigEntry) in the merged OpenFang config (openfang.vibemind.toml merged with ~/.openfang/config.toml at startup); config hot-reload watches mcp_servers changes.",
    "agent_scope_mechanism": "Per-agent scopes are the top-level mcp_servers allowlist in openfang/agents/<agent>/agent.toml, generated exclusively from the registry by scripts/sync_openfang_agents.py after its three fail-closed validators pass; capability tools are derived only from registry mcp_tools, never from mcp_servers.",
    "empty_scope_semantics": "OpenFang interprets an empty AgentManifest mcp_servers list as ALL connected MCP servers. Enabled agents must therefore declare a non-empty allowlist or no_mcp = true.",
    "mutation_requires": "runtime-authority",
    "mutation_task": "task-integration-0005b",
    "standing_autonomy_sufficient": false,
    "protected_hand_curated_agents": ["brain-coder", "rowboat-chat", "brain-fallback"],
    "registration_evidence": {
      "static": [
        "Config entry present at the pinned revision (openfang.vibemind.toml [[mcp_servers]])",
        "Agent manifest scope pinned by OpenFang's own test test_vibemind_brain_manifests_use_top_level_mcp_servers",
        "sync_openfang_agents.py --check reports no drift",
        "This contract validated by tests/integration/test_openfang_mcp_authority_contract_v1.py"
      ],
      "live": {
