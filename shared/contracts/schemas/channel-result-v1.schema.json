{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:channel-result:v1",
  "title": "ChannelResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "correlation_id",
    "channel_kind",
    "actor_context",
    "session_context",
    "plan_id",
    "participating_space_ids",
    "status",
    "summary"
  ],
  "properties": {
    "contract_version": {"const": "v1"},
    "correlation_id": {"$ref": "#/$defs/sharedV1Id"},
    "channel_kind": {"enum": ["voice", "desktop-chat", "openclaw", "space-chat"]},
    "actor_context": {"$ref": "#/$defs/actorContext"},
    "session_context": {"$ref": "#/$defs/sessionContext"},
    "plan_id": {"$ref": "#/$defs/planId"},
    "participating_space_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/spaceId"}
    },
    "status": {
      "enum": ["pending", "in_progress", "waiting_for_approval", "succeeded", "failed", "cancelled", "unavailable"]
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "approval_ref": {"$ref": "#/$defs/approvalRef"},
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidenceRef"}
    }
  },
  "$defs": {
    "sharedV1Id": {
      "type": "string",
      "pattern": "^(?:task|event|evidence|handoff|todo|approval|plan)_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"
    },
    "planId": {
      "type": "string",
      "pattern": "^plan_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"
    },
    "approvalRef": {
      "type": "string",
      "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"
    },
    "evidenceRef": {
      "type": "string",
      "pattern": "^evidence_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"
    },
    "spaceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "actorContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "locale": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"}
      }
    },
    "sessionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "conversation_id": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    }
  }
}
