{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:vibemind:shared:contracts:rowboat-knowledge-plan:v1", "title": "RowboatKnowledgePlanV1", "type": "object", "additionalProperties": false,
  "required": ["contract_version", "plan_id", "plan_version", "plan_hash", "request_id", "project_ref", "task_ref", "trace_id", "space_id", "requested_output", "created_at", "source_policy", "sources", "stages", "required_citation_count", "evidence_required", "output_artifact_ref"],
  "properties": {"contract_version": {"const": "v1"}, "plan_id": {"$ref": "#/$defs/planRef"}, "plan_version": {"type": "integer", "minimum": 1, "maximum": 1000000}, "plan_hash": {"$ref": "#/$defs/hash"}, "request_id": {"$ref": "#/$defs/requestRef"}, "project_ref": {"$ref": "#/$defs/projectRef"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "trace_id": {"$ref": "#/$defs/traceRef"}, "space_id": {"const": "rowboat"}, "requested_output": {"enum": ["knowledge_search", "briefing", "draft"]}, "created_at": {"$ref": "#/$defs/timestamp"}, "source_policy": {"$ref": "#/$defs/sourcePolicy"}, "sources": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/source"}}, "stages": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/$defs/stage"}}, "required_citation_count": {"type": "integer", "minimum": 1, "maximum": 50}, "evidence_required": {"const": true}, "output_artifact_ref": {"$ref": "#/$defs/artifactRef"}},
  "$defs": {"planRef": {"type": "string", "pattern": "^plan_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "projectRef": {"type": "string", "pattern": "^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "artifactRef": {"type": "string", "pattern": "^artifact_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "sourceRef": {"type": "string", "pattern": "^source_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}, "sourcePolicy": {"type": "object", "additionalProperties": false, "required": ["allowed_source_kinds", "citation_required"], "properties": {"allowed_source_kinds": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["workspace", "uploaded", "curated", "approved"]}}, "citation_required": {"const": true}}}, "source": {"type": "object", "additionalProperties": false, "required": ["source_ref", "source_kind"], "properties": {"source_ref": {"$ref": "#/$defs/sourceRef"}, "source_kind": {"enum": ["workspace", "uploaded", "curated", "approved"]}}}, "stage": {"type": "object", "additionalProperties": false, "required": ["stage_id", "order", "kind", "depends_on", "source_refs"], "properties": {"stage_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}, "order": {"type": "integer", "minimum": 1, "maximum": 500}, "kind": {"enum": ["retrieve", "compose", "verify"]}, "depends_on": {"type": "array", "maxItems": 499, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}}, "source_refs": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceRef"}}}}}
}
