{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:vibemind:shared:contracts:rowboat-knowledge-result:v1", "title": "RowboatKnowledgeResultV1", "type": "object", "additionalProperties": false,
