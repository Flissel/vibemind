  "properties": {"contract_version": {"const": "v1"}, "result_id": {"$ref": "#/$defs/resultRef"}, "run_id": {"$ref": "#/$defs/runRef"}, "plan_id": {"$ref": "#/$defs/planRef"}, "plan_version": {"type": "integer", "minimum": 1, "maximum": 1000000}, "plan_hash": {"$ref": "#/$defs/hash"}, "request_id": {"$ref": "#/$defs/requestRef"}, "project_ref": {"$ref": "#/$defs/projectRef"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "trace_id": {"$ref": "#/$defs/traceRef"}, "space_id": {"const": "rowboat"}, "requested_output": {"enum": ["knowledge_search", "briefing", "draft"]}, "mode": {"const": "offline"}, "outcome": {"enum": ["succeeded", "failed", "cancelled", "unavailable"]}, "started_at": {"$ref": "#/$defs/timestamp"}, "completed_at": {"$ref": "#/$defs/timestamp"}, "sources": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/source"}}, "citations": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/citation"}}, "artifact_refs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactRef"}}, "evidence_refs": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}}, "log_refs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/logRef"}}, "counters": {"$ref": "#/$defs/counters"}, "cost": {"$ref": "#/$defs/cost"}, "error_class": {"enum": ["policy_blocked", "source_unavailable", "execution_failed", "deadline_exceeded", "unavailable"]}},
  "allOf": [{"if": {"properties": {"outcome": {"const": "succeeded"}}}, "then": {"not": {"required": ["error_class"]}, "properties": {"sources": {"minItems": 1}, "citations": {"minItems": 1}, "artifact_refs": {"minItems": 1}, "evidence_refs": {"minItems": 1}, "log_refs": {"minItems": 1}, "counters": {"properties": {"executed_steps": {"minimum": 1}}}}}}, {"if": {"properties": {"outcome": {"enum": ["failed", "unavailable"]}}}, "then": {"required": ["error_class"]}}],
  "$defs": {"resultRef": {"type": "string", "pattern": "^result_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "runRef": {"type": "string", "pattern": "^run_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "planRef": {"type": "string", "pattern": "^plan_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "projectRef": {"type": "string", "pattern": "^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "sourceRef": {"type": "string", "pattern": "^source_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "citationRef": {"type": "string", "pattern": "^citation_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "evidenceRef": {"type": "string", "pattern": "^evidence_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "artifactRef": {"type": "string", "pattern": "^artifact_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "logRef": {"type": "string", "pattern": "^log_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "quoteRef": {"type": "string", "pattern": "^quote_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "approvalRef": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}, "source": {"type": "object", "additionalProperties": false, "required": ["source_ref", "source_kind", "evidence_ref"], "properties": {"source_ref": {"$ref": "#/$defs/sourceRef"}, "source_kind": {"enum": ["workspace", "uploaded", "curated", "approved"]}, "evidence_ref": {"$ref": "#/$defs/evidenceRef"}}}, "citation": {"type": "object", "additionalProperties": false, "required": ["citation_ref", "claim_id", "source_ref", "evidence_ref", "locator_ref"], "properties": {"citation_ref": {"$ref": "#/$defs/citationRef"}, "claim_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}, "source_ref": {"$ref": "#/$defs/sourceRef"}, "evidence_ref": {"$ref": "#/$defs/evidenceRef"}, "locator_ref": {"type": "string", "pattern": "^locator_v1_[a-z][a-z0-9-]{0,62}$"}}}, "counters": {"type": "object", "additionalProperties": false, "required": ["sources_examined", "chunks_examined", "executed_steps", "retry_count", "active_stages", "actual_cost_minor"], "properties": {"sources_examined": {"type": "integer", "minimum": 0, "maximum": 50}, "chunks_examined": {"type": "integer", "minimum": 0, "maximum": 500}, "executed_steps": {"type": "integer", "minimum": 0, "maximum": 500}, "retry_count": {"type": "integer", "minimum": 0, "maximum": 10}, "active_stages": {"type": "integer", "minimum": 0, "maximum": 16}, "actual_cost_minor": {"type": "integer", "minimum": 0, "maximum": 10000000}}}, "cost": {"type": "object", "additionalProperties": false, "required": ["actual_cost_minor", "currency", "quote_ref", "approval_ref"], "properties": {"actual_cost_minor": {"type": "integer", "minimum": 0, "maximum": 10000000}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "quote_ref": {"$ref": "#/$defs/quoteRef"}, "approval_ref": {"$ref": "#/$defs/approvalRef"}}}}
