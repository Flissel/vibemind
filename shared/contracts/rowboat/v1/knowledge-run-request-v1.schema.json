{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:vibemind:shared:contracts:rowboat-knowledge-run-request:v1", "title": "RowboatKnowledgeRunRequestV1", "type": "object", "additionalProperties": false,
  "required": ["contract_version", "run_id", "plan_id", "plan_version", "plan_hash", "request_id", "project_ref", "task_ref", "trace_id", "space_id", "requested_output", "mode", "input_artifact_refs", "input_evidence_refs", "limits", "quote_ref", "approval_ref", "idempotency_key"],
  "properties": {"contract_version": {"const": "v1"}, "run_id": {"$ref": "#/$defs/runRef"}, "plan_id": {"$ref": "#/$defs/planRef"}, "plan_version": {"type": "integer", "minimum": 1, "maximum": 1000000}, "plan_hash": {"$ref": "#/$defs/hash"}, "request_id": {"$ref": "#/$defs/requestRef"}, "project_ref": {"$ref": "#/$defs/projectRef"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "trace_id": {"$ref": "#/$defs/traceRef"}, "space_id": {"const": "rowboat"}, "requested_output": {"enum": ["knowledge_search", "briefing", "draft"]}, "mode": {"const": "offline"}, "input_artifact_refs": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactRef"}}, "input_evidence_refs": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}}, "limits": {"$ref": "#/$defs/bounds"}, "quote_ref": {"$ref": "#/$defs/quoteRef"}, "approval_ref": {"$ref": "#/$defs/approvalRef"}, "idempotency_key": {"$ref": "#/$defs/idempotency"}},
  "$defs": {"runRef": {"type": "string", "pattern": "^run_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "planRef": {"type": "string", "pattern": "^plan_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "projectRef": {"type": "string", "pattern": "^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "artifactRef": {"type": "string", "pattern": "^artifact_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "evidenceRef": {"type": "string", "pattern": "^evidence_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "quoteRef": {"type": "string", "pattern": "^quote_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "approvalRef": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "idempotency": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}, "bounds": {"type": "object", "additionalProperties": false, "required": ["max_sources", "max_chunks", "timeout_seconds", "max_steps", "max_retries", "max_concurrency", "max_cost_minor", "currency"], "properties": {"max_sources": {"type": "integer", "minimum": 1, "maximum": 50}, "max_chunks": {"type": "integer", "minimum": 1, "maximum": 500}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "max_steps": {"type": "integer", "minimum": 1, "maximum": 500}, "max_retries": {"type": "integer", "minimum": 0, "maximum": 10}, "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 16}, "max_cost_minor": {"type": "integer", "minimum": 0, "maximum": 10000000}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}}}
}
