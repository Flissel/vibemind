{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:rowboat-knowledge-request:v1",
  "title": "RowboatKnowledgeRequestV1", "type": "object", "additionalProperties": false,
  "required": ["contract_version", "request_id", "project_ref", "task_ref", "trace_id", "space_id", "objective", "query", "requested_output", "requested_at", "clarification", "source_policy", "hard_bounds", "quote_ref", "approval_ref", "idempotency_key"],
  "properties": {
    "contract_version": {"const": "v1"}, "request_id": {"$ref": "#/$defs/requestRef"}, "project_ref": {"$ref": "#/$defs/projectRef"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "trace_id": {"$ref": "#/$defs/traceRef"}, "space_id": {"const": "rowboat"}, "ingress_alias": {"const": "roarboot"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000}, "query": {"type": "string", "minLength": 1, "maxLength": 4000}, "requested_output": {"enum": ["knowledge_search", "briefing", "draft"]}, "requested_at": {"$ref": "#/$defs/timestamp"}, "clarification": {"$ref": "#/$defs/clarification"}, "source_policy": {"$ref": "#/$defs/sourcePolicy"}, "hard_bounds": {"$ref": "#/$defs/bounds"}, "quote_ref": {"$ref": "#/$defs/quoteRef"}, "approval_ref": {"$ref": "#/$defs/approvalRef"}, "idempotency_key": {"$ref": "#/$defs/idempotency"}
  },
  "$defs": {
    "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "projectRef": {"type": "string", "pattern": "^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "quoteRef": {"type": "string", "pattern": "^quote_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "approvalRef": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}, "idempotency": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "clarification": {"type": "object", "additionalProperties": false, "required": ["status", "questions"], "properties": {"status": {"enum": ["required", "resolved"]}, "questions": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 500}}, "resolved_at": {"type": ["string", "null"], "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}}, "allOf": [{"if": {"properties": {"status": {"const": "required"}}}, "then": {"properties": {"questions": {"minItems": 1}, "resolved_at": {"type": "null"}}}}, {"if": {"properties": {"status": {"const": "resolved"}}}, "then": {"required": ["resolved_at"], "properties": {"questions": {"maxItems": 0}, "resolved_at": {"$ref": "#/$defs/timestamp"}}}}]},
    "sourcePolicy": {"type": "object", "additionalProperties": false, "required": ["allowed_source_kinds", "citation_required"], "properties": {"allowed_source_kinds": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["workspace", "uploaded", "curated", "approved"]}}, "citation_required": {"const": true}}},
    "bounds": {"type": "object", "additionalProperties": false, "required": ["max_sources", "max_chunks", "timeout_seconds", "max_steps", "max_retries", "max_concurrency", "max_cost_minor", "currency"], "properties": {"max_sources": {"type": "integer", "minimum": 1, "maximum": 50}, "max_chunks": {"type": "integer", "minimum": 1, "maximum": 500}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "max_steps": {"type": "integer", "minimum": 1, "maximum": 500}, "max_retries": {"type": "integer", "minimum": 0, "maximum": 10}, "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 16}, "max_cost_minor": {"type": "integer", "minimum": 0, "maximum": 10000000}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}}
  }
}
