{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:n8n-operation-authority:v1",
  "title": "N8nOperationAuthorityV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "authority_ref", "operation", "run_id", "definition_id", "workflow_id", "workflow_version", "definition_revision", "definition_hash", "request_id", "task_ref", "project_ref", "trace_id", "mode", "approval_ref", "issued_at", "expires_at", "idempotency_key"],
  "properties": {
    "contract_version": {"const": "v1"},
    "authority_ref": {"$ref": "#/$defs/authorityRef"},
    "operation": {"enum": ["read-status", "trigger", "cancel"]},
    "run_id": {"$ref": "#/$defs/runRef"},
    "definition_id": {"$ref": "#/$defs/definitionRef"},
    "workflow_id": {"$ref": "#/$defs/workflowRef"},
    "workflow_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "definition_revision": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "definition_hash": {"$ref": "#/$defs/hash"},
    "request_id": {"$ref": "#/$defs/requestRef"},
    "task_ref": {"$ref": "#/$defs/taskRef"},
    "project_ref": {"$ref": "#/$defs/projectRef"},
    "trace_id": {"$ref": "#/$defs/traceRef"},
    "mode": {"enum": ["test", "manual", "production"]},
    "approval_ref": {"$ref": "#/$defs/approvalRef"},
    "issued_at": {"$ref": "#/$defs/time"},
    "expires_at": {"$ref": "#/$defs/time"},
    "idempotency_key": {"$ref": "#/$defs/idempotencyKey"}
  },
  "$defs": {
    "authorityRef": {"type": "string", "pattern": "^authority_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "runRef": {"type": "string", "pattern": "^run_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "definitionRef": {"type": "string", "pattern": "^definition_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "workflowRef": {"type": "string", "pattern": "^workflow_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "projectRef": {"type": "string", "pattern": "^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "approvalRef": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}
  }
}
