{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:n8n-workflow-request:v1",
  "title": "WorkflowRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "task_ref", "project_ref", "trace_id", "intent_kind", "intent_ref", "requested_at", "clarification", "risk_class", "hard_bounds", "idempotency_key"],
  "properties": {
    "contract_version": {"const": "v1"},
    "request_id": {"$ref": "#/$defs/requestRef"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "project_ref": {"$ref": "#/$defs/projectRef"}, "trace_id": {"$ref": "#/$defs/traceRef"},
    "intent_kind": {"enum": ["brain", "chat"]}, "intent_ref": {"$ref": "#/$defs/intentRef"}, "requested_at": {"$ref": "#/$defs/timestamp"},
    "clarification": {"$ref": "#/$defs/clarification"}, "risk_class": {"enum": ["low", "medium", "high", "critical"]},
    "hard_bounds": {"$ref": "#/$defs/hardBounds"}, "idempotency_key": {"$ref": "#/$defs/idempotencyKey"}
  },
  "$defs": {
    "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "projectRef": {"type": "string", "pattern": "^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "intentRef": {"type": "string", "pattern": "^intent_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}, "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "clarification": {"type": "object", "additionalProperties": false, "required": ["required", "questions"], "properties": {"required": {"type": "boolean"}, "questions": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 500}}}},
    "hardBounds": {"type": "object", "additionalProperties": false, "required": ["timeout_seconds", "max_steps", "max_retries", "max_cost_minor", "currency"], "properties": {"timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "max_steps": {"type": "integer", "minimum": 1, "maximum": 500}, "max_retries": {"type": "integer", "minimum": 0, "maximum": 10}, "max_cost_minor": {"type": "integer", "minimum": 0, "maximum": 10000000}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}}
  }
}
