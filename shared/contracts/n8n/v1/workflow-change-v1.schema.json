{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:n8n-workflow-change:v1",
  "title": "WorkflowChangeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "change_id", "definition_id", "workflow_id", "request_id", "trace_id", "action", "expected_lifecycle", "expected_revision", "approval_ref", "idempotency_key"],
  "properties": {
    "contract_version": {"const": "v1"}, "change_id": {"type": "string", "pattern": "^change_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "definition_id": {"type": "string", "pattern": "^definition_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "workflow_id": {"type": "string", "pattern": "^workflow_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "request_id": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "trace_id": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "action": {"enum": ["create", "update", "activate", "deactivate", "archive"]}, "expected_lifecycle": {"enum": ["absent", "draft", "active", "inactive"]}, "expected_revision": {"type": "integer", "minimum": 0, "maximum": 999999}, "approval_ref": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}
  },
  "allOf": [
    {"if": {"properties": {"action": {"const": "create"}}}, "then": {"properties": {"expected_lifecycle": {"const": "absent"}, "expected_revision": {"const": 0}}}},
    {"if": {"properties": {"action": {"const": "update"}}}, "then": {"properties": {"expected_lifecycle": {"enum": ["draft", "active", "inactive"]}, "expected_revision": {"minimum": 1}}}},
    {"if": {"properties": {"action": {"const": "activate"}}}, "then": {"properties": {"expected_lifecycle": {"enum": ["draft", "inactive"]}, "expected_revision": {"minimum": 1}}}},
    {"if": {"properties": {"action": {"const": "deactivate"}}}, "then": {"properties": {"expected_lifecycle": {"const": "active"}, "expected_revision": {"minimum": 1}}}},
    {"if": {"properties": {"action": {"const": "archive"}}}, "then": {"properties": {"expected_lifecycle": {"enum": ["draft", "active", "inactive"]}, "expected_revision": {"minimum": 1}}}}
  ]
}
