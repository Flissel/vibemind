{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:n8n-workflow-definition-ref:v1",
  "title": "WorkflowDefinitionRefV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "definition_id", "workflow_id", "request_id", "task_ref", "project_ref", "trace_id", "workflow_version", "revision", "lifecycle", "definition_hash", "workflow_artifact_ref", "evidence_refs", "declared_trigger_class", "capability_refs", "approval_ref"],
  "properties": {
    "contract_version": {"const": "v1"}, "definition_id": {"$ref": "#/$defs/definitionRef"}, "workflow_id": {"$ref": "#/$defs/workflowRef"}, "request_id": {"$ref": "#/$defs/requestRef"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "project_ref": {"$ref": "#/$defs/projectRef"}, "trace_id": {"$ref": "#/$defs/traceRef"},
    "workflow_version": {"type": "integer", "minimum": 1, "maximum": 1000000}, "revision": {"type": "integer", "minimum": 1, "maximum": 1000000}, "lifecycle": {"enum": ["draft", "active", "inactive", "archived"]}, "definition_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "workflow_artifact_ref": {"$ref": "#/$defs/artifactRef"}, "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}, "declared_trigger_class": {"enum": ["manual", "event", "scheduled"]}, "capability_refs": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/capabilityRef"}}, "approval_ref": {"$ref": "#/$defs/approvalRef"}
  },
  "$defs": {
    "definitionRef": {"type": "string", "pattern": "^definition_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "workflowRef": {"type": "string", "pattern": "^workflow_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "projectRef": {"type": "string", "pattern": "^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "artifactRef": {"type": "string", "pattern": "^artifact_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "capabilityRef": {"type": "string", "pattern": "^capability_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "approvalRef": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}
  }
}
