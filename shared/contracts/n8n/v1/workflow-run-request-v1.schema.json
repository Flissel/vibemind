{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:n8n-workflow-run-request:v1",
  "title": "WorkflowRunRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run_id", "definition_id", "workflow_id", "workflow_version", "definition_revision", "definition_hash", "request_id", "task_ref", "project_ref", "trace_id", "mode", "input_artifact_refs", "input_evidence_refs", "timeout_seconds", "max_steps", "max_retries", "budget", "idempotency_key"],
  "properties": {
    "contract_version": {"const": "v1"}, "run_id": {"$ref": "#/$defs/runRef"}, "definition_id": {"$ref": "#/$defs/definitionRef"}, "workflow_id": {"$ref": "#/$defs/workflowRef"}, "workflow_version": {"type": "integer", "minimum": 1, "maximum": 1000000}, "definition_revision": {"type": "integer", "minimum": 1, "maximum": 1000000}, "definition_hash": {"$ref": "#/$defs/hash"}, "request_id": {"$ref": "#/$defs/requestRef"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "project_ref": {"$ref": "#/$defs/projectRef"}, "trace_id": {"$ref": "#/$defs/traceRef"},
    "mode": {"enum": ["test", "manual", "production"]}, "input_artifact_refs": {"$ref": "#/$defs/artifactRefs"}, "input_evidence_refs": {"$ref": "#/$defs/evidenceRefs"}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "max_steps": {"type": "integer", "minimum": 1, "maximum": 500}, "max_retries": {"type": "integer", "minimum": 0, "maximum": 10}, "budget": {"$ref": "#/$defs/budget"}, "idempotency_key": {"$ref": "#/$defs/idempotencyKey"}
  },
  "$defs": {
    "runRef": {"type": "string", "pattern": "^run_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "definitionRef": {"type": "string", "pattern": "^definition_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "workflowRef": {"type": "string", "pattern": "^workflow_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "projectRef": {"type": "string", "pattern": "^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "artifactRefs": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^artifact_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}, "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["max_cost_minor", "currency", "quote_ref", "approval_ref"], "properties": {"max_cost_minor": {"type": "integer", "minimum": 0, "maximum": 10000000}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "quote_ref": {"type": "string", "pattern": "^quote_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "approval_ref": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}}
  }
}
