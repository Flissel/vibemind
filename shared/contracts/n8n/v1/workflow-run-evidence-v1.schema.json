{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:n8n-workflow-run-evidence:v1",
  "title": "WorkflowRunEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run_id", "definition_id", "workflow_id", "workflow_version", "definition_revision", "definition_hash", "request_id", "task_ref", "project_ref", "trace_id", "mode", "outcome", "started_at", "completed_at", "executed_steps", "evidence_refs", "artifact_refs", "log_refs", "cost"],
  "properties": {
    "contract_version": {"const": "v1"}, "run_id": {"$ref": "#/$defs/runRef"}, "definition_id": {"$ref": "#/$defs/definitionRef"}, "workflow_id": {"$ref": "#/$defs/workflowRef"}, "workflow_version": {"type": "integer", "minimum": 1, "maximum": 1000000}, "definition_revision": {"type": "integer", "minimum": 1, "maximum": 1000000}, "definition_hash": {"$ref": "#/$defs/hash"}, "request_id": {"$ref": "#/$defs/requestRef"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "project_ref": {"$ref": "#/$defs/projectRef"}, "trace_id": {"$ref": "#/$defs/traceRef"}, "mode": {"enum": ["test", "manual", "production"]}, "outcome": {"enum": ["succeeded", "failed", "cancelled", "unavailable"]}, "started_at": {"$ref": "#/$defs/timestamp"}, "completed_at": {"$ref": "#/$defs/timestamp"}, "executed_steps": {"type": "integer", "minimum": 0, "maximum": 500}, "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}, "artifact_refs": {"$ref": "#/$defs/artifactRefs"}, "log_refs": {"$ref": "#/$defs/logRefs"}, "error_class": {"enum": ["policy_blocked", "execution_failed", "deadline_exceeded", "unavailable"]}, "cost": {"$ref": "#/$defs/cost"}
  },
  "allOf": [{"if": {"properties": {"outcome": {"const": "succeeded"}}}, "then": {"properties": {"executed_steps": {"minimum": 1}, "evidence_refs": {"minItems": 1}, "artifact_refs": {"minItems": 1}, "log_refs": {"minItems": 1}}, "not": {"required": ["error_class"]}}}, {"if": {"properties": {"outcome": {"enum": ["failed", "unavailable"]}}}, "then": {"required": ["error_class"]}}, {"if": {"properties": {"outcome": {"const": "cancelled"}}}, "then": {"not": {"required": ["error_class"]}}}],
  "$defs": {
    "runRef": {"type": "string", "pattern": "^run_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "definitionRef": {"type": "string", "pattern": "^definition_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "workflowRef": {"type": "string", "pattern": "^workflow_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "projectRef": {"type": "string", "pattern": "^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "evidenceRefs": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}, "artifactRefs": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^artifact_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}, "logRefs": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^log_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}, "cost": {"type": "object", "additionalProperties": false, "required": ["actual_cost_minor", "currency", "quote_ref", "approval_ref"], "properties": {"actual_cost_minor": {"type": "integer", "minimum": 0, "maximum": 10000000}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "quote_ref": {"type": "string", "pattern": "^quote_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "approval_ref": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}}
  }
}
