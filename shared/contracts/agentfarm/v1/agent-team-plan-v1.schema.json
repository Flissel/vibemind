{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:vibemind:shared:contracts:agentfarm-team-plan:v1", "title": "AgentTeamPlanV1", "type": "object", "additionalProperties": false,
  "required": ["contract_version", "plan_id", "plan_version", "plan_hash", "request_id", "brain_plan_ref", "task_ref", "project_ref", "trace_id", "space_id", "created_at", "plan_artifact_ref", "plan_evidence_refs", "max_concurrency", "members", "tasks"],
  "properties": {"contract_version": {"const": "v1"}, "plan_id": {"$ref": "#/$defs/planRef"}, "plan_version": {"type": "integer", "minimum": 1, "maximum": 1000000}, "plan_hash": {"$ref": "#/$defs/hash"}, "request_id": {"$ref": "#/$defs/requestRef"}, "brain_plan_ref": {"$ref": "#/$defs/planRef"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "project_ref": {"$ref": "#/$defs/projectRef"}, "trace_id": {"$ref": "#/$defs/traceRef"}, "space_id": {"const": "agentfarm"}, "created_at": {"$ref": "#/$defs/timestamp"}, "plan_artifact_ref": {"$ref": "#/$defs/artifactRef"}, "plan_evidence_refs": {"$ref": "#/$defs/evidenceRefs"}, "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 16}, "members": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/member"}}, "tasks": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/task"}}},
  "$defs": {"planRef": {"type": "string", "pattern": "^plan_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "projectRef": {"type": "string", "pattern": "^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "artifactRef": {"type": "string", "pattern": "^artifact_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}, "capabilityRef": {"type": "string", "pattern": "^capability_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}, "member": {"type": "object", "additionalProperties": false, "required": ["member_id", "role", "capability_refs", "max_concurrency"], "properties": {"member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "role": {"type": "string", "minLength": 1, "maxLength": 100}, "capability_refs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/capabilityRef"}}, "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 16}}}, "task": {"type": "object", "additionalProperties": false, "required": ["task_id", "member_id", "capability_ref", "depends_on", "order", "required"], "properties": {"task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "capability_ref": {"$ref": "#/$defs/capabilityRef"}, "depends_on": {"type": "array", "maxItems": 127, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}}, "order": {"type": "integer", "minimum": 1, "maximum": 1000000}, "