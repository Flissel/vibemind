{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:vibemind:shared:contracts:agentfarm-task-event:v1", "title": "AgentTaskEventV1", "type": "object", "additionalProperties": false,
  "required": ["contract_version", "event_id", "run_id", "plan_id", "plan_version", "plan_hash", "member_id", "task_id", "revision", "occurred_at", "status", "dependency_refs", "executed_steps", "retry_count", "actual_cost_minor", "evidence_refs", "artifact_refs", "log_refs"],
  "properties": {"contract_version": {"const": "v1"}, "event_id": {"$ref": "#/$defs/eventRef"}, "run_id": {"$ref": "#/$defs/runRef"}, "plan_id": {"$ref": "#/$defs/planRef"}, "plan_version": {"type": "integer", "minimum": 1, "maximum": 1000000}, "plan_hash": {"$ref": "#/$defs/hash"}, "member_id": {"$ref": "#/$defs/name"}, "task_id": {"$ref": "#/$defs/name"}, "revision": {"type": "integer", "minimum": 1, "maximum": 1000000}, "occurred_at": {"$ref": "#/$defs/timestamp"}, "status": {"enum": ["queued", "running", "succeeded", "failed", "cancelled", "unavailable"]}, "dependency_refs": {"type": "array", "maxItems": 127, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}, "executed_steps": {"type": "integer", "minimum": 0, "maximum": 500}, "retry_count": {"type": "integer", "minimum": 0, "maximum": 10}, "actual_cost_minor": {"type": "integer", "minimum": 0, "maximum": 10000000}, "evidence_refs": {"$ref": "#/$defs/evidence"}, "artifact_refs": {"$ref": "#/$defs/artifacts"}, "log_refs": {"$ref": "#/$defs/logs"}, "error_class": {"enum": ["policy_blocked", "execution_failed", "deadline_exceeded", "unavailable"]}},
  "allOf": [{"if": {"properties": {"status": {"enum": ["failed", "unavailable"]}}}, "then": {"required": ["error_class"]}}, {"if": {"properties": {"status": {"const": "succeeded"}}}, "then": {"properties": {"executed_steps": {"minimum": 1}, "evidence_refs": {"minItems": 1}, "artifact_refs": {"minItems": 1}, "log_refs": {"minItems": 1}}, "not": {"required": ["error_class"]}}}],
  "$defs": {"eventRef": {"type": "string", "pattern": "^event_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "runRef": {"type": "string", "pattern": "^run_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "planRef": {"type": "string", "pattern": "^plan_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}, "evidence": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}, "artifacts": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^artifact_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}, "logs": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^log_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}}
}
