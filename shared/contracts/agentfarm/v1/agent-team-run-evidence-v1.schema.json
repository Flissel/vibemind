{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:vibemind:shared:contracts:agentfarm-team-run-evidence:v1", "title": "AgentTeamRunEvidenceV1", "type": "object", "additionalProperties": false,
  "required": ["contract_version", "run_id", "plan_id", "plan_version", "plan_hash", "request_id", "task_ref", "project_ref", "trace_id", "space_id", "mode", "outcome", "started_at", "completed_at", "member_summaries", "task_summaries", "executed_steps", "evidence_refs", "artifact_refs", "log_refs", "actual_cost_minor", "currency", "quote_ref", "approval_ref"],
  "properties": {"contract_version": {"const": "v1"}, "run_id": {"$ref": "#/$defs/runRef"}, "plan_id": {"$ref": "#/$defs/planRef"}, "plan_version": {"type": "integer", "minimum": 1, "maximum": 1000000}, "plan_hash": {"$ref": "#/$defs/hash"}, "request_id": {"$ref": "#/$defs/requestRef"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "project_ref": {"$ref": "#/$defs/projectRef"}, "trace_id": {"$ref": "#/$defs/traceRef"}, "space_id": {"const": "agentfarm"}, "mode": {"enum": ["dry_run", "manual", "production"]}, "outcome": {"enum": ["succeeded", "failed", "cancelled", "unavailable"]}, "started_at": {"$ref": "#/$defs/timestamp"}, "completed_at": {"$ref": "#/$defs/timestamp"}, "member_summaries": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/memberSummary"}}, "task_summaries": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/taskSummary"}}, "executed_steps": {"type": "integer", "minimum": 0, "maximum": 500}, "evidence_refs": {"$ref": "#/$defs/evidence"}, "artifact_refs": {"$ref": "#/$defs/artifacts"}, "log_refs": {"$ref": "#/$defs/logs"}, "actual_cost_minor": {"type": "integer", "minimum": 0, "maximum": 10000000}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "quote_ref": {"$ref": "#/$defs/quoteRef"}, "approval_ref": {"$ref": "#/$defs/approvalRef"}, "error_class": {"enum": ["policy_blocked", "execution_failed", "deadline_exceeded", "unavailable"]}},
  "allOf": [{"if": {"properties": {"outcome": {"const": "succeeded"}}}, "then": {"properties": {"executed_steps": {"minimum": 1}, "evidence_refs": {"minItems": 1}, "artifact_refs": {"minItems": 1}, "log_refs": {"minItems": 1}}, "not": {"required": ["error_class"]}}}, {"if": {"properties": {"outcome": {"enum": ["failed", "unavailable"]}}}, "then": {"required": ["error_class"]}}],
  "$defs": {"runRef": {"type": "string", "pattern": "^run_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "planRef": {"type": "string", "pattern": "^plan_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "projectRef": {"type": "string", "pattern": "^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "quoteRef": {"type": "string", "pattern": "^quote_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "approvalRef": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}, "memberSummary": {"type": "object", "additionalProperties": false, "required": ["member_id", "status"], "properties": {"member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "status": {"enum": ["succeeded", "failed", "cancelled", "unavailable"]}}}, "taskSummary": {"type": "object", "additionalProperties": false, "required": ["task_id", "status"], "properties": {"task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "status": {"enum": ["succeeded", "failed", "cancelled", "unavailable"]}}}, "evidence": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}, "artifacts": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^artifact_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}, "logs": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^log_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}}}
}
