{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:agentfarm-team-request:v1",
  "title": "AgentTeamRequestV1", "type": "object", "additionalProperties": false,
  "required": ["contract_version", "request_id", "brain_plan_ref", "task_ref", "project_ref", "trace_id", "space_id", "objective", "requested_at", "clarification", "risk_class", "hard_bounds", "quote_ref", "approval_ref", "idempotency_key"],
  "properties": {
    "contract_version": {"const": "v1"}, "request_id": {"$ref": "#/$defs/requestRef"}, "brain_plan_ref": {"$ref": "#/$defs/planRef"}, "task_ref": {"$ref": "#/$defs/taskRef"}, "project_ref": {"$ref": "#/$defs/projectRef"}, "trace_id": {"$ref": "#/$defs/traceRef"}, "space_id": {"const": "agentfarm"}, "ingress_alias": {"const": "autogen"}, "objective": {"type": "string", "minLength": 1, "maxLength": 2000}, "requested_at": {"$ref": "#/$defs/timestamp"}, "clarification": {"$ref": "#/$defs/clarification"}, "risk_class": {"enum": ["low", "medium", "high", "critical"]}, "hard_bounds": {"$ref": "#/$defs/bounds"}, "quote_ref": {"$ref": "#/$defs/quoteRef"}, "approval_ref": {"$ref": "#/$defs/approvalRef"}, "idempotency_key": {"$ref": "#/$defs/idempotency"}
  },
  "$defs": {
    "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "planRef": {"type": "string", "pattern": "^plan_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "projectRef": {"type": "string", "pattern": "^project_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "quoteRef": {"type": "string", "pattern": "^quote_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "approvalRef": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"}, "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}, "idempotency": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "clarification": {"type": "object", "additionalProperties": false, "required": ["status", "questions"], "properties": {"status": {"enum": ["required", "resolved"]}, "questions": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 500}}, "resolved_at": {"type": ["string", "null"], "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}}, "allOf": [{"if": {"properties": {"status": {"const": "required"}}}, "then": {"properties": {"questions": {"minItems": 1}, "resolved_at": {"type": "null"}}}}, {"if": {"properties": {"status": {"const": "resolved"}}}, "then": {"required": ["resolved_at"], "properties": {"questions": {"maxItems": 0}, "resolved_at": {"$ref": "#/$defs/timestamp"}}}}]},
    "bounds": {"type": "object", "additionalProperties": false, "required": ["timeout_seconds", "max_steps", "max_retries", "max_cost_minor", "currency", "max_concurrency", "max_team_members"], "properties": {"timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "max_steps": {"type": "integer", "minimum": 1, "maximum": 500}, "max_retries": {"type": "integer", "minimum": 0, "maximum": 10}, "max_cost_minor": {"type": "integer", "minimum": 0, "maximum": 10000000}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 16}, "max_team_members": {"type": "integer", "minimum": 1, "maximum": 16}}}
  }
}
