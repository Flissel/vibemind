{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibemind:shared:contracts:agentfarm-openfang-handoff-admission:v1",
  "title": "AgentFarmOpenFangHandoffAdmissionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "handoff_id",
    "request_id",
    "task_ref",
    "brain_task_node_id",
    "source_provenance_id",
    "trace_id",
    "correlation_id",
    "space_id",
    "executor",
    "handoff_status",
    "approval_ref",
    "quote_ref",
    "idempotency_key",
    "issued_at",
    "execution_boundary"
  ],
  "properties": {
    "contract_version": {"const": "v1"},
    "handoff_id": {"$ref": "#/$defs/handoffRef"},
    "request_id": {"$ref": "#/$defs/requestRef"},
    "task_ref": {"$ref": "#/$defs/taskRef"},
    "brain_task_node_id": {"$ref": "#/$defs/brainTaskNodeId"},
    "source_provenance_id": {"$ref": "#/$defs/sourceRef"},
    "trace_id": {"$ref": "#/$defs/traceRef"},
    "correlation_id": {"$ref": "#/$defs/correlationRef"},
    "space_id": {"const": "agentfarm"},
    "executor": {"const": "openfang"},
    "handoff_status": {"const": "pending_openfang_admission"},
    "approval_ref": {"$ref": "#/$defs/approvalRef"},
    "quote_ref": {"$ref": "#/$defs/quoteRef"},
    "idempotency_key": {"$ref": "#/$defs/idempotency"},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_provider_access",
        "direct_application_access",
        "fallback_allowed"
      ],
      "properties": {
        "direct_provider_access": {"const": false},
        "direct_application_access": {"const": false},
        "fallback_allowed": {"const": false}
      }
    }
  },
  "$defs": {
    "handoffRef": {"type": "string", "pattern": "^handoff_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "requestRef": {"type": "string", "pattern": "^request_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "taskRef": {"type": "string", "pattern": "^task_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "brainTaskNodeId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "sourceRef": {"type": "string", "pattern": "^source_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "traceRef": {"type": "string", "pattern": "^trace_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "correlationRef": {"type": "string", "pattern": "^(?:task|event|evidence|handoff|todo|approval|plan)_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "quoteRef": {"type": "string", "pattern": "^quote_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "approvalRef": {"type": "string", "pattern": "^approval_v1_[0-9A-HJKMNPQRSTVWXYZ]{26}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "idempotency": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}
  }
}
