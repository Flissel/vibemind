# VibeMind root environment — copy to .env and fill in your own values.
# Never commit the real .env. All keys below are read by infra/swarm/
# vibemind-stack.yml (via env interpolation or scripts/swarm_secrets_init.ps1)
# and by the operational scripts in scripts/.

# --- LLM providers (at least one required) ---------------------------------
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Supabase (self-hosted stack) ------------------------------------------
# Dev defaults exist in the stack file; rotate for anything reachable from
# outside your machine (see SECURITY.md).
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n --------------------------------------------------------------------
N8N_API_KEY=
N8N_ENCRYPTION_KEY=

# --- Agents / services ------------------------------------------------------
AGENTS_API_KEY=
EMBEDDING_SERVICE_URL=

# --- MiroFish space (optional, AGPL subtree — see THIRD_PARTY.md) -----------
MIROFISH_LLM_API_KEY=
MIROFISH_LLM_MODEL=
MIROFISH_EMBEDDING_MODEL=
MIROFISH_NEO4J_URI=
MIROFISH_NEO4J_USER=
MIROFISH_NEO4J_PASSWORD=
DECISION_GRAPH_NEO4J_URI=

# --- GPU (optional) ---------------------------------------------------------
# Comma-separated device ids for services that can use CUDA; empty = CPU.
VIBEMIND_GPU_DEVICES=

# --- Telegram (approval cards, marketing sends) ---------------------------
# Comma-separated operator chat ids. Empty = fail closed (no sends).
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_CHAT_ID=
