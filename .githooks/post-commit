#!/bin/sh
# Central post-commit hook — triggers incremental fungus-search reindex.
#
# This hook is shared by VibeMind worktrees through core.hooksPath. It must
# only use a locally verified updater; an uncertain candidate never blocks a
# commit and is intentionally ignored.

canonical_dir() {
  [ -d "$1" ] || return 1
  CDPATH= cd -- "$1" 2>/dev/null && pwd -P
}

is_git_top_level() {
  requested_root="$(canonical_dir "$1")" || return 1
  git_root="$(git -C "$requested_root" rev-parse --show-toplevel 2>/dev/null)" || return 1
  git_root="$(canonical_dir "$git_root")" || return 1
  [ "$requested_root" = "$git_root" ]
}

tracked_and_clean_updater() {
  fungus_root="$1"
  updater_path="$fungus_root/incremental_updater.py"

  [ -f "$updater_path" ] && [ -r "$updater_path" ] && [ ! -L "$updater_path" ] || return 1
  git -C "$fungus_root" ls-files --error-unmatch -- incremental_updater.py >/dev/null 2>&1 || return 1
  git -C "$fungus_root" diff --quiet -- incremental_updater.py >/dev/null 2>&1 || return 1
  git -C "$fungus_root" diff --cached --quiet -- incremental_updater.py >/dev/null 2>&1 || return 1
}

gitlink_matches_head() {
  parent_root="$1"
  gitlink_path="$2"
  child_root="$3"

  gitlink_head="$(git -C "$parent_root" rev-parse --verify "HEAD:$gitlink_path" 2>/dev/null)" || return 1
  child_head="$(git -C "$child_root" rev-parse --verify HEAD 2>/dev/null)" || return 1
  [ "$gitlink_head" = "$child_head" ]
}

accept_direct_fungus_root() {
  candidate_root="$1"
  [ ! -L "$candidate_root" ] || return 1
  candidate_root="$(canonical_dir "$candidate_root")" || return 1
  is_git_top_level "$candidate_root" || return 1
  tracked_and_clean_updater "$candidate_root" || return 1
  [ -f "$candidate_root/mcp_server.py" ] && [ ! -L "$candidate_root/mcp_server.py" ] || return 1
  git -C "$candidate_root" ls-files --error-unmatch -- mcp_server.py >/dev/null 2>&1 || return 1
  git -C "$candidate_root" diff --quiet -- mcp_server.py >/dev/null 2>&1 || return 1
  git -C "$candidate_root" diff --cached --quiet -- mcp_server.py >/dev/null 2>&1 || return 1
  origin_url="$(git -C "$candidate_root" remote get-url origin 2>/dev/null)" || return 1
  case "$origin_url" in
    https://github.com/Flissel/la_fungus_search|https://github.com/Flissel/la_fungus_search.git|git@github.com:Flissel/la_fungus_search.git|ssh://git@github.com/Flissel/la_fungus_search.git) ;;
    *) return 1 ;;
  esac
  UPDATER="$candidate_root/incremental_updater.py"
}

accept_nested_fungus_root() {
  candidate_root="$1"
  vibemind_root="$2"
  outer_root="$3"

  [ ! -L "$candidate_root" ] && [ ! -L "$vibemind_root" ] || return 1
  candidate_root="$(canonical_dir "$candidate_root")" || return 1
  vibemind_root="$(canonical_dir "$vibemind_root")" || return 1
  [ "$(basename "$vibemind_root")" = "vibemind-os" ] || return 1
  is_git_top_level "$candidate_root" || return 1
  is_git_top_level "$vibemind_root" || return 1
  tracked_and_clean_updater "$candidate_root" || return 1
  gitlink_matches_head "$vibemind_root" la-fungus-search "$candidate_root" || return 1

  if [ -n "$outer_root" ]; then
    [ ! -L "$outer_root" ] || return 1
    outer_root="$(canonical_dir "$outer_root")" || return 1
    is_git_top_level "$outer_root" || return 1
    gitlink_matches_head "$outer_root" vibemind-os "$vibemind_root" || return 1
  fi

  UPDATER="$candidate_root/incremental_updater.py"
}

# Git supplies the committing repository, including for nested service paths.
# Without a Git top-level there is no trusted worktree to inspect.
REPO_CWD="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
REPO_CWD="$(canonical_dir "$REPO_CWD")" || exit 0

# The log stays next to the configured central hook, never next to a primary
# checkout selected by an absolute user path.
HOOK_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P)" || exit 0
HOOK_ROOT="$(canonical_dir "$HOOK_DIR/..")" || exit 0
LOG_DIR="${HOOK_ROOT}/backups"

UPDATER=""

# (a) A direct fungus root is valid only when the committing repository itself
# owns the clean, tracked updater.
if [ -e "$REPO_CWD/incremental_updater.py" ] || [ -L "$REPO_CWD/incremental_updater.py" ]; then
  accept_direct_fungus_root "$REPO_CWD" || exit 0
else
  # (b)/(c) inspect at most eight enclosing worktree levels, nearest first.
  SEARCH_DIR="$REPO_CWD"
  ASCENT=0
  while [ "$ASCENT" -lt 8 ]; do
    if [ -e "$SEARCH_DIR/la-fungus-search" ] || [ -L "$SEARCH_DIR/la-fungus-search" ]; then
      accept_nested_fungus_root "$SEARCH_DIR/la-fungus-search" "$SEARCH_DIR" "" || exit 0
      break
    fi

    if [ -e "$SEARCH_DIR/vibemind-os" ] || [ -L "$SEARCH_DIR/vibemind-os" ]; then
      accept_nested_fungus_root "$SEARCH_DIR/vibemind-os/la-fungus-search" "$SEARCH_DIR/vibemind-os" "$SEARCH_DIR" || exit 0
      break
    fi

    PARENT_DIR="$(canonical_dir "$SEARCH_DIR/..")" || exit 0
    [ "$PARENT_DIR" = "$SEARCH_DIR" ] && break
    SEARCH_DIR="$PARENT_DIR"
    ASCENT=$((ASCENT + 1))
  done
fi

[ -n "$UPDATER" ] || exit 0
command -v python >/dev/null 2>&1 || exit 0
umask 077
mkdir -p "$LOG_DIR" 2>/dev/null || exit 0

# --background performs the one detached Popen inside the updater. This
# synchronous wrapper returns promptly and its status is the spawn acceptance.
python "$UPDATER" --background --repo-cwd "$REPO_CWD" \
  > "${LOG_DIR}/fungus_inc_hook.log" 2>&1
SPAWN_STATUS=$?

if [ "$SPAWN_STATUS" -eq 0 ]; then
  echo "[fungus-inc] reindex triggered from $(basename "$REPO_CWD") (log: ${LOG_DIR}/fungus_inc_*.log)" || true
fi

exit 0
